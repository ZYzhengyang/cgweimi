{
	id: 'b2c3d4e5-f6a7-8901-bcde-f23456789012',

	name: 'CG Light',
	author: 'CGweimi',
	desc: 'CG微米浅色主题 — 产品圣经 V3.0 §18',

	base: 'light',

	props: {
		// 品牌色（强调色全文 ≤ 5 处使用）
		accent: '#ff6b35',
		accentedBg: ':alpha<0.15<@accent',
		fgOnAccent: '#FFFFFF',

		// 背景层次
		bg: '#FAFAFA',
		panel: '#FFFFFF',
		panelHighlight: '#F4F4F4',
		panelHeaderBg: '#FFFFFF',
		panelHeaderFg: '@fg',
		popup: '#FFFFFF',
		focus: ':alpha<0.3<@accent',
		windowHeader: ':alpha<0.95<@panel',
		dateLabelFg: '@fg',
		panelBorder: '" solid 1px var(--MI_THEME-divider)',

		// 文字层次
		fg: '#111111',
		fgHighlighted: '#000000',
		fgOnWhite: '#333',

		// 边框 & 阴影（默认无阴影，优先边框/留白）
		divider: '#EAEAEA',
		shadow: 'rgba(0, 0, 0, 0.04)',
		indicator: '@accent',

		// 导航 & 页头
		header: ':alpha<0.95<@panel',
		navBg: '#FFFFFF',
		navFg: '@fg',
		navActive: '@accent',
		navIndicator: '@accent',
		pageHeaderBg: '@bg',
		pageHeaderFg: '@fg',

		// 交互色
		link: '#0066cc',
		hashtag: '#0066cc',
		mention: '#ff6b35',
		mentionMe: '#ff8555',
		renote: '#10b981',

		// 模态层
		modalBg: 'rgba(0, 0, 0, 0.4)',

		// 滚动条
		scrollbarHandle: 'rgba(0, 0, 0, 0.15)',
		scrollbarHandleHover: 'rgba(0, 0, 0, 0.3)',

		// 信息提示
		infoBg: '#e8f0fe',
		infoFg: '#0f172a',
		infoWarnBg: '#fff7ed',
		infoWarnFg: '#9a3412',

		// 文件夹
		folderHeaderBg: 'rgba(0, 0, 0, 0.03)',
		folderHeaderHoverBg: 'rgba(0, 0, 0, 0.06)',

		// 按钮
		buttonBg: '#F4F4F4',
		buttonHoverBg: '#EAEAEA',
		buttonGradateA: '@accent',
		buttonGradateB: ':hue<15<@accent',

		// 开关
		switchBg: 'rgba(0, 0, 0, 0.15)',
		switchOffBg: 'rgba(0, 0, 0, 0.1)',
		switchOffFg: '@panel',
		switchOnBg: '@accentedBg',
		switchOnFg: '@accent',

		// 输入框
		inputBorder: '#EAEAEA',
		inputBorderHover: '#d0d0d0',

		// 状态
		badge: '#ff6b35',
		messageBg: '@bg',
		success: '#10b981',
		error: '#ef4444',
		warn: '#f59e0b',

		// 代码高亮
		codeString: '#ff6b35',
		codeNumber: '#10b981',
		codeBoolean: '#0066cc',

		// 其他
		deckBg: '#F4F4F4',
		htmlThemeColor: '#FAFAFA',
		love: '#ef4444',
	},

	codeHighlighter: {
		base: 'github-light',
	},
}